    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "node-cron": "^4.4.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
