# Kapila Hotel — backend/.env
# Copy this file to backend/.env and fill real values. NEVER commit backend/.env
# (already in .gitignore — keep it that way).

# ── Server ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development                      # development | production
FRONTEND_ORIGIN=http://localhost:5173     # CORS allow-list — set to real domain in prod

# ── Database (Postgres) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/kapila

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-random   # rotate for prod, invalidates all sessions on change
JWT_ACCESS_TTL=15m                         # optional, defaults inside authService.js
REFRESH_TOKEN_DAYS=7                       # optional, defaults inside authService.js

# Used only by migration 017 to seed the first admin account — remove/rotate
# after first run, do not leave a real password sitting in .env long-term.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI (OCR / voice-parse / smart-autofill) ─────────────────────────────
# Code reads GEMINI_API_KEY (services/localAI.js). The old backend/.env.example
# said ANTHROPIC_API_KEY — that was stale/wrong, this file is the corrected one.
GEMINI_API_KEY=

# ── Kafka event bus (stock/indent/issuance sync) ────────────────────────
# Optional — app runs fine without a broker, publish() fails safe and logs a
# warning; reorder-breach checks fall back to running in-process instead.
KAFKA_BROKER=localhost:9092

# ── WhatsApp (Meta Graph API) — shrinkage alerts + day-close digest ─────
# Without these, both anomalyDetector.js cron and the day-close digest
# (indentController.closeDay) just console.log a mock message instead of
# sending — safe default, no crash, but nobody gets notified.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
ADMIN_WHATSAPP_NUMBER=                     # single number, E.164 format e.g. 91XXXXXXXXXX

# ── High-value indent/issuance alert thresholds ─────────────────────────
# Absolute Rs. value or total qty that triggers a CRITICAL in-app
# notification to admin + store_manager roles (utils/highValueAlert.js).
HIGH_VALUE_ALERT_AMOUNT=20000
HIGH_VALUE_ALERT_QTY=100
