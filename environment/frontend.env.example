# Kapila Hotel — frontend/.env
# Copy to frontend/.env (Vite auto-loads it). NEVER commit frontend/.env.
#
# WARNING: every var prefixed VITE_ gets baked into the client JS bundle at
# build time and is visible to anyone via browser devtools / view-source.
# Never put a real secret behind a VITE_ var.

# Backend API base URL. Empty/default → falls back to relative "/api"
# (same-origin, works when frontend is served behind the backend or a proxy).
VITE_API_URL=http://localhost:3001/api

# Dead/legacy — api/client.js sends this as an "x-api-key" header, but no
# backend route ever reads or validates that header (grepped, zero hits).
# Leave unset. If you do set it, it ships to the browser — never put a real
# Anthropic/Gemini key here, that key would be stealable from any client tab.
# VITE_API_KEY=
# VITE_ANTHROPIC_API_KEY=
