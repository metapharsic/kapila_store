++PORT=3001
++DATABASE_URL=postgresql://postgres:password@localhost:5432/kapila
++NODE_ENV=development
++JWT_SECRET=change-me-min-32-chars-random
++
++# Code reads GEMINI_API_KEY (services/localAI.js) ╬ô├ç├╢ powers OCR/voice-parse/
++# smart-autofill.
++GEMINI_API_KEY=
++
++# Optional fallback: if Gemini hits quota/billing limits, callGemini() retries
++# via Claude (Anthropic Messages API) instead of failing to local regex/mock.
++# Voice transcription stays Gemini-only (Claude has no audio input).
++ANTHROPIC_API_KEY=
++
++# Local no-key fallback tier (see config/ollama.md). Defaults below match a
++# standard `ollama serve` on the same machine ╬ô├ç├╢ only set if different.
++OLLAMA_URL=http://localhost:11434
++OLLAMA_MODEL=qwen
++OLLAMA_VISION_MODEL=llava
++
++# Kafka broker for stock/indent/issuance event bus (services/kafkaProducer.js).
++# App runs fine without it ╬ô├ç├╢ publish calls fail-safe and just log a warning.
++KAFKA_BROKER=localhost:9092
++
++# WhatsApp (Meta Graph API) ╬ô├ç├╢ shrinkage alerts + day-close digest. Without
++# these, alerts just console.log a mock message instead of sending.
++WHATSAPP_TOKEN=
++WHATSAPP_PHONE_ID=
++ADMIN_WHATSAPP_NUMBER=
++STORE_MANAGER_WHATSAPP_NUMBER=
++
++# See environment/backend.env.example (repo root) for the full annotated list.
